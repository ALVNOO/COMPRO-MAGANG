APP_NAME="Sistem Penerimaan Magang"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_VERSION=1.0.0
APP_REGION=sulbagsel

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokal: SQLite. Produksi (Vercel + PostgreSQL): set DB_CONNECTION=pgsql dan isi host/user/password.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=magang
# DB_USERNAME=postgres
# DB_PASSWORD=

# DB_CONNECTION=pgsql
# DB_HOST=ep-wandering-bird-a1mnmud8-pooler.ap-southeast-1.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=neondb_owner
# DB_PASSWORD=endpoint=<endpoint-id>$<actual-password>
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# ── CDN & Storage ────────────────────────────────────────────────────────────
# ASSET_URL=https://cdn.example.com    # CDN prefix for compiled CSS/JS assets
# UPLOAD_DISK=public                   # Use 's3' to store uploads in S3 bucket

# ── Redis (enables Redis-backed cache, session, queue, rate-limiting) ────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_CLUSTER=redis                  # 'redis' = native Redis Cluster (consistent hashing)
# REDIS_PREFIX=                        # Auto-generated from APP_NAME if not set

# ── Production overrides (switch from database → redis drivers) ──────────────
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS S3 (for UPLOAD_DISK=s3) ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Read Replica (for DB_CONNECTION=mysql) ───────────────────────────────────
# DB_READ_HOST=                        # Read replica host; falls back to DB_HOST if empty

VITE_APP_NAME="${APP_NAME}"